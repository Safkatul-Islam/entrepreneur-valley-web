# ──────────────────────────────────────────────────────────────────────────────
# Supabase (server-only service role; do NOT expose to client)
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ──────────────────────────────────────────────────────────────────────────────
# Site URLs
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional override; falls back to ${NEXT_PUBLIC_SITE_URL}/register/sharks-valley
NEXT_PUBLIC_REGISTER_URL=

# ──────────────────────────────────────────────────────────────────────────────
# Discord
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DISCORD_INVITE=https://discord.gg/cMkdZQGCSE

# ──────────────────────────────────────────────────────────────────────────────
# LUMA (attendee registration handled by partner club)
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LUMA_EVENT_URL=https://luma.com/r2zgp0fc

# ──────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile (bot protection)
# Get keys at: https://dash.cloudflare.com → Turnstile → Add Site
# Use the test keys for local dev:
#   site:   1x00000000000000000000AA  (always passes)
#   secret: 1x0000000000000000000000000000000AA
# ──────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ──────────────────────────────────────────────────────────────────────────────
# Resend (transactional email)
# Get an API key at: https://resend.com → API Keys
# RESEND_FROM_EMAIL must be a verified domain in Resend.
# ADMIN_NOTIFICATION_EMAILS is a comma-separated list of admin recipients.
# ──────────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=Entrepreneur Valley <noreply@entrepreneursvalley.club>
ADMIN_NOTIFICATION_EMAILS=you@example.com,president@example.com
